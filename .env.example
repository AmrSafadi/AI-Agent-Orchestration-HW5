# Optional local environment settings for reproducible experiments.
# Leave values blank unless a command explicitly needs them.

# Hugging Face token for gated/private models. Public models used in the final
# benchmark do not require this.
HF_TOKEN=

# Optional OpenAI key for future API experiments. The submitted economic
# analysis uses public pricing assumptions and does not call the API.
OPENAI_API_KEY=

# Local Ollama endpoint used by experiments/run_ollama.py.
OLLAMA_HOST=http://127.0.0.1:11434
